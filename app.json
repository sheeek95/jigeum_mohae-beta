{
  "expo": {
    "name": "지금 모해",
    "slug": "jigeummohae",
    "version": "1.0.0",
    "scheme": "jigeummohae",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#120C24",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jigeummohae.app",
      "infoPlist": {
        "NSCameraUsageDescription": "친구에게 지금 이 순간을 사진으로 공유하기 위해 카메라를 사용해요.",
        "NSPhotoLibraryUsageDescription": "저장을 승인한 사진을 앨범에 남기기 위해 사진 보관함에 접근해요.",
        "NSPhotoLibraryAddUsageDescription": "저장을 승인한 사진을 앨범에 남기기 위해 사진 보관함에 접근해요."
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.jigeummohae.app"]
      }
    },
    "android": {
      "package": "com.jigeummohae.app",
      "adaptiveIcon": {
        "backgroundColor": "#120C24",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-notifications",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "af86bc4a009c8090ed0f65667f5299ee"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "친구에게 지금 이 순간을 사진으로 공유하기 위해 카메라를 사용해요."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "JigeumMohae",
              "label": "지금 모해",
              "description": "친구가 보낸 사진이 바로 뜨는 위젯 · 대기중일 땐 탭하면 바로 촬영해요.",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional"
            }
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/36f65830-f225-417a-9276-c70c600f4e26"
    },
    "extra": {
      "eas": {
        "projectId": "36f65830-f225-417a-9276-c70c600f4e26"
      }
    }
  }
}
