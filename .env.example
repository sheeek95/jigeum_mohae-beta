# Base URL of the server/ backend. On expo web this can stay localhost since
# both run on the same host. On a physical device/simulator, localhost means
# the device itself — use your machine's LAN IP (e.g. http://192.168.1.5:4000)
# for a physical phone, or http://10.0.2.2:4000 for the Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:4000
